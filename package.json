{
  "name": "wildrift-stats",
  "private": true,
  "version": "0.1.0",
  "description": "Wild Rift ranked champion win, pick and ban rates over time (China server).",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run data:build && vite",
    "build": "npm run data:build && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch": "node scripts/fetch-stats.ts",
    "fetch:fixtures": "node scripts/fetch-stats.ts --stats-file scripts/fixtures/hero_rank_list_v2.json --heroes-file scripts/fixtures/hero_list.json --ddragon-file scripts/fixtures/ddragon_champion.json --dry-run",
    "data:build": "node scripts/build-data.ts",
    "probe:history": "node scripts/probe-history.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
